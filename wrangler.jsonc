{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gutsmartlive",
  "account_id": "cd720601278558af8fbd688ae4d11c07",
  "main": "src/worker.js",
  "build": { "command": "node scripts/build.mjs" },
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gutsmartlive-db",
      "database_id": "31ce93e5-15c1-47be-ba22-fa2db204622e",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    "crons": ["15 10 * * *", "0 13 * * 1"]
  },
  "routes": [
    { "pattern": "gutsmartlive.com", "custom_domain": true },
    { "pattern": "www.gutsmartlive.com", "custom_domain": true },
    { "pattern": "gutsmartlive.org", "custom_domain": true },
    { "pattern": "www.gutsmartlive.org", "custom_domain": true }
  ],
  "vars": {
    "SITE_URL": "https://gutsmartlive.com",
    "FROM_EMAIL": "Gut Smart Live <hello@gutsmartlive.com>"
  },
  "observability": { "enabled": true }
}
